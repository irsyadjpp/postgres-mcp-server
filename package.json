{
  "name": "@irsyadjpp/postgres-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for PostgreSQL with 40+ tools for database administration, performance monitoring, and Java backend integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "postgres-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck",
    "prepublishOnly": "npm run validate && npm run build && npm test",
    "publish:public": "npm publish --access public",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kysely",
    "database",
    "postgresql",
    "postgres",
    "sql",
    "orm",
    "typescript",
    "spring-boot",
    "hibernate",
    "hikaricp",
    "dba",
    "monitoring"
  ],
  "author": "Irsyad <irsyadjpratamap@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irsyadjpp/postgres-mcp-server.git"
  },
  "homepage": "https://github.com/irsyadjpp/postgres-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/irsyadjpp/postgres-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^16.4.5",
    "kysely": "^0.27.3",
    "pg": "^8.11.5",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@testcontainers/postgresql": "^10.13.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
