# Database Configuration
# Copy this file to .env and update with your database credentials

# Required: Database password for default database
DB_PASSWORD=your_database_password_here

# Default database connection settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres

# Additional databases (optional)
# Use naming convention: DB_<NAME>_HOST, DB_<NAME>_PORT, DB_<NAME>_USER, DB_<NAME>_PASSWORD, DB_<NAME>_DATABASE
# Example for a production database:
# DB_PROD_HOST=prod.example.com
# DB_PROD_PORT=5432
# DB_PROD_USER=app_user
# DB_PROD_PASSWORD=prod_password
# DB_PROD_DATABASE=production
# DB_PROD_POOL_MAX=10
# DB_PROD_SSL=true

# Alternative: Use JSON config file for multiple databases
# Set DB_CONFIG_PATH to point to a JSON file with database configurations
# DB_CONFIG_PATH=/path/to/db-config.json

# Connection pool settings
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=5000
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# SSL Configuration
DB_SSL=true
# Set to false to reject self-signed certificates (default: true for security)
DB_SSL_REJECT_UNAUTHORIZED=true
# Set to true to allow self-signed certificates (useful for development)
DB_SSL_ALLOW_SELF_SIGNED=false
# Optional: Path to CA certificate file
# DB_SSL_CA_CERT=/path/to/ca-certificate.crt

# Security Settings
# Set to false to allow write operations (INSERT, UPDATE, DELETE)
READ_ONLY=true
# Set to true (with READ_ONLY=false) to enable DDL operations
# (CREATE, ALTER, DROP, TRUNCATE, etc.). Use with extreme caution.
# ALLOW_DDL=false

# Pagination Settings
MAX_PAGE_SIZE=500
DEFAULT_PAGE_SIZE=100

# Development settings
NODE_ENV=development